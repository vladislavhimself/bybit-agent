# Режим: demo (Bybit Demo Trading, реальные цены, виртуальные деньги) | testnet | live
BOT_MODE=demo

# Ключи Bybit. Для demo создаются в разделе Demo Trading на bybit.com, для testnet на testnet.bybit.com
# Права: только торговля (Contract/Unified Trade). Вывод средств ЗАПРЕЩЁН.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Ключ Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Telegram: токен от @BotFather и ваш chat_id (узнать у @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X (Twitter) API v2 Bearer Token (developer.x.com -> Developer Console). Оплата по факту, ~0.005$ за пост,
# при привязке карты дают 20$ бесплатно. Без токена Маск и Трамп идут через Telegram-зеркала и Truth Social
TWITTER_BEARER_TOKEN=
# Необязательно: CryptoPanic, CoinMarketCal
CRYPTOPANIC_API_KEY=
COINMARKETCAL_API_KEY=

# Если сервер в России и API Bybit/Anthropic недоступны напрямую, укажите прокси
# HTTPS_PROXY=http://user:pass@host:port
